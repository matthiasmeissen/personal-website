---
import SVG from '../assets/bike-tribal.svg';
---


<div class="container">
    <a>
        <div class="title">Bike Tribals</div>
        <div class="description">mmn-obj-002</div>
        <div class="year">2025</div>
    </a>
</div>

<style>
    .container {
        width: 100%;
        padding: 0 var(--space-md);
        display: flex;
        justify-content: center;
        margin-bottom: var(--space-sm);
    }

    a {
        position: relative;
        width: 100%;
        max-width: var(--space-content-md);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
        padding: var(--space-sm);
        color: var(--color-foreground-primary);
        background-color: var(--color-background-primary);
        border-radius: 12px;
        font-size: var(--font-size-md);
        text-decoration: none;
        overflow: hidden;
        transition: all 0.2s ease-in-out;
    }
    a:hover {
        filter: invert(1);
        transform: scale(1.02);
        cursor: pointer;
    }

    .title {
        flex-grow: 1;
    }

    .description {
        color: var(--color-foreground-subtle);
    }

    .year {
        color: var(--color-foreground-subtle);
    }

    .preview {
        position: absolute;
        right: 0;
        width: 40%;
        opacity: 10%;
    }

    @media (max-width: 480px) {
        .container {
            padding: 0 20px;
        }

        a {
            padding: 12px 8px;
        }

        .description {
            display: none;
        }
    }
</style>
