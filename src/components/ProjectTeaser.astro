---
interface Props {
    id: string;
    title: string;
    link: string;
    svgName: string; // e.g., "bike-tribal.svg"
}

const { id, title, link, svgName } = Astro.props;

/* 
   DYNAMIC SVG LOADING
   1. glob: Grab all .svg files in ../assets/
   2. query: '?raw' imports them as strings (code) instead of URLs
   3. import: 'default' gives us the string directly
*/
const svgs = import.meta.glob('../assets/*.svg', { 
    query: '?raw', 
    import: 'default' 
});

// Construct the lookup key (must match the file structure relative to this component)
const svgPath = `../assets/${svgName}`;

// Validate that the file exists
if (!(svgPath in svgs)) {
    throw new Error(`[TeaserCard] SVG not found: "${svgPath}". Check filename in src/assets/`);
}

// Load the specific SVG
const loadSvg = svgs[svgPath];
const SVG = await loadSvg() as string;
---

<div class="container">
    <!-- Foreground Card -->
    <a href={link} class="card">
        <div class="top">{id}</div>
        <div class="svg">
            <Fragment set:html={SVG} />
        </div>
        <div class="bottom">{title}</div>
    </a>

    <!-- Background Layer -->
    <div class="background-svg">
        <Fragment set:html={SVG} />
    </div>
</div>


<style>
    .container {
        position: relative; 
        
        width: 100%;
        max-width: 1200px;
        aspect-ratio: 4/3;
        
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto;
        overflow: hidden; 
    }

    .card {
        position: relative; 
        z-index: 1;
        
        width: max(20vw, 280px);
        aspect-ratio: 1/1;
        background-color: var(--color-background-subtle);
        padding: 20px;
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        transition: all 0.2s ease-in-out;
    }
    .card:hover,
    .card:focus {
        filter: invert(1);
        transform: scale(1.02);
    }

    .top, .bottom {
        flex-shrink: 0;
    }

    .top {
        text-align: end;
    }

    .svg {
        width: 100%;
        min-height: 0;
        flex-grow: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .container :global(svg) {
        stroke: var(--color-foreground-primary);
        fill: none;
        vector-effect: non-scaling-stroke;
    }

    .svg :global(svg) {
        width: 100%;
        height: 100%;
        max-height: 100%;
    }

    .background-svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        
        z-index: 0; 
        opacity: 0.2; 
        pointer-events: none;
        
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .background-svg :global(svg) {
        width: 100%;
        height: 100%;
        object-fit: cover; 
    }
</style>