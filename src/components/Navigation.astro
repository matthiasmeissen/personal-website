---
import Logo from '../assets/logo.svg?raw'
---

<nav>
    <a href="/">
        <div class="logo-wrapper">
            <Fragment set:html={Logo} />        
        </div>
    </a>

    <div>
        <a href="#">Work</a>
        <a href="#">Write</a>
    </div>
</nav>

<style>
    nav {
        position: fixed;
        width: 100%;
        padding: 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .logo-wrapper :global(svg) {
        width: 48px;
        height: 48px;
        stroke: var(--color-foreground-primary);
    }
</style>
