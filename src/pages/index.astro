<style>
	.intro {
		width: 100%;
		height: 40vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		padding: 32px;
	}

	p {
		font-size: var(--font-size-sm);
		text-align: end;
		color: var(--color-foreground-subtle);
