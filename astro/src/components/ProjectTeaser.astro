---
import type { ImageMetadata } from 'astro';

const { 
    id = "mmn-obj-001", 
    title = "Title", 
    link = "#",
    imageName = "bike-tribal.svg"
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{svg,png,jpg,jpeg,webp}');

const imagePath = `../assets/${imageName}`;

if (!images[imagePath]) {
    throw new Error(`[TeaserCard] Image "${imagePath}" not found. Is it in src/assets/?`);
}

const imageModule = await images[imagePath]();
const imageSrc = imageModule.default.src;
---


<div class="container">
    <a href={link} class="card">
        <div class="id">{id}</div>
        <div class="image" style={`background-image: url(${imageSrc});`}></div>
        <div class="title">{title}</div>
    </a>

    <div class="background-image" style={`background-image: url(${imageSrc});`}></div>
</div>

<style>
    .container {
        position: relative;
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px;
    }

    .card {
        width: 100%;
        max-width: 780px;
        aspect-ratio: 3/2;
        background-color: var(--color-background-subtle);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        padding: 20px;
        border: 1px solid var(--color-foreground-muted);
        text-decoration: none;
        transition: all 0.2s ease-in-out;
        z-index: 1;
    }
    .card:hover {
        transform: scale(1.01);
        border-color: var(--color-foreground-subtle);
        cursor: pointer;
    }

    .id {
        font-size: var(--font-size-sm);
        padding: 4px 8px;
        color: var(--color-foreground-subtle);
        border: 1px solid var(--color-foreground-subtle);
        border-radius: 20px;
        width: fit-content;
        place-self: flex-end;
    }

    .image {
        flex-grow: 1;
        height: fit-content;
        background-position: center;
        background-repeat: no-repeat;
        background-size: contain;
    }

    .background-image {
        position: absolute;
        width: 100%;
        height: 100%;
        background-position: center;
        background-repeat: no-repeat;
        background-size: contain;
        opacity: 10%;
    }

    .title {
        font-size: var(--font-size-md);
    }

    @media (max-width: 520px) {
        .container {
            height: 80vh;
            padding: 32px;
        }
        .card {
            aspect-ratio: 1/1;
        }
        .background-image {
            background-size: cover;
        }
    }
</style>
