---
import Logo from '../assets/logo.svg?raw'
---

<a href="/" class="container">
    <Fragment set:html={Logo} />        
</a>

<style>
    .container {
        position: fixed;
        top: 32px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
    }

    .container :global(svg) {
        width: 48px;
        height: 48px;
        stroke: var(--color-foreground-primary);
    }
</style>
